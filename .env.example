# Copy to .env (or .env.local) for `npm run dev` / `npm start`, or pass as
# container env in AWS. The only secret is BITRIX_EXPORT_API_KEY (server-side).
# Read at request time, so one image serves every environment. The browser
# never sees these URLs: it calls /api/ad/*, /api/lead/*, /api/zoho/* and /api/bitrix/*, which this server
# forwards to the matching backend.

# ---- Ad generator module -> ad-generator-backend --------------------------
BACKEND_BASE_URL=http://localhost:8000
# Per-module override; falls back to BACKEND_BASE_URL if unset.
AD_GENERATOR_BACKEND_URL=
# Shows the "Paid promotion" panel (creates real draft ad campaigns).
ENABLE_PAID_PROMOTION=false
# Prefill the Generate form (all stay editable in the UI).
DEFAULT_COMPANY_URL=
DEFAULT_COMPANY_NAME=
DEFAULT_CONTACT_URL=

# ---- Lead source module -> lead-source backend ----------------------------
# Falls back to legacy BACKEND_URL, then backend.default_url in
# src/config/lead-source.json. Never falls back to BACKEND_BASE_URL.
LEAD_SOURCE_BACKEND_URL=http://localhost:8001
# Optional partial override of src/config/lead-source.json (same contract).
# The STREAMLIT_ prefix is historical; kept so existing deployments carry over.
# S3 uses the normal AWS credential chain (the ECS task role in AWS).
STREAMLIT_CONFIG_S3_URI=
STREAMLIT_CONFIG_FILE=

# ---- Export leads to Zoho module -> zohoexport backend --------------------
# Serves leads from RDS by date range and exports them to Zoho CRM + Campaigns.
# No fallback to the other modules' backends.
ZOHO_INTEGRATION_BACKEND_URL=http://zoho-export.leadsource.local:8000

# ---- Bitrix export module -> bitrixexport backend -------------------------
# Lists Bitrix24 CRM forms and fetches their leads by date range; the page then
# exports them through the Zoho module's backend (ZOHO_INTEGRATION_BACKEND_URL).
# No fallback to the other modules' backends.
BITRIX_EXPORT_BACKEND_URL=http://localhost:8003
# The backend's EXPORT_API_KEY, if it sets one. Sent server-side as X-API-Key;
# never exposed to the browser.
BITRIX_EXPORT_API_KEY=
