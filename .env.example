# Copy this file to .env and adjust. .env is gitignored. The frontend holds no
# secrets — every credential lives in each backend's own .env.
#
# Each module talks to its OWN backend, so each has its own URL. Locally both
# backends default to port 8000, so run one of them on another port (the
# examples below assume the lead-source backend runs on 8001).

# ---- Ad generator module -> ad-generator-backend --------------------------
#   local:  http://localhost:8000     docker: http://host.docker.internal:8000
#   AWS:    the backend's public URL
BACKEND_BASE_URL=http://localhost:8000
# Per-module override; falls back to BACKEND_BASE_URL if unset.
AD_GENERATOR_BACKEND_URL=

# Shows/hides the "Paid promotion" panel in the Ad generator's Image & publish
# tab. Leave false until the paid-ads settings in the backend are configured.
ENABLE_PAID_PROMOTION=false
# Prefill the Ad generator's Generate form (all stay editable in the UI).
DEFAULT_COMPANY_URL=
DEFAULT_COMPANY_NAME=
DEFAULT_CONTACT_URL=

# ---- Lead source module -> lead-source backend ----------------------------
# Falls back to the legacy BACKEND_URL, then to backend.default_url in
# lead_source/streamlit_config.json (http://localhost:8000). It deliberately
# does NOT fall back to BACKEND_BASE_URL, which is the Ad generator's backend.
LEAD_SOURCE_BACKEND_URL=http://localhost:8001
# Optional UI config override for the Lead source module (same JSON contract
# as lead_source/streamlit_config.json). S3 uses the normal AWS credential chain.
STREAMLIT_CONFIG_S3_URI=
STREAMLIT_CONFIG_FILE=
